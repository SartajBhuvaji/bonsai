# Copy to .env and fill in. .env itself is gitignored.

# Hugging Face token: pulls gated datasets (bigcode/the-stack-dedup) and pushes checkpoints.
HF_TOKEN=

# Speeds up large Hugging Face downloads; harmless if unset.
HF_XET_HIGH_PERFORMANCE=1

# DigitalOcean API token, for tools/launch_do.sh and tools/do_status.sh.
# Generate one at https://cloud.digitalocean.com/account/api/tokens with read+write scope.
DIGITALOCEAN_ACCESS_TOKEN=
