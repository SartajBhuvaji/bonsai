# Copy to .env and fill in. .env itself is gitignored.

# Hugging Face token, needed to pull gated datasets (bigcode/the-stack-dedup)
# and to push checkpoints.
HF_TOKEN=

# Speeds up large downloads from Hugging Face; harmless if unset.
HF_XET_HIGH_PERFORMANCE=1

# Only needed for tools/launch_do.sh (programmatic GPU Droplet provisioning).
# Generate one at https://cloud.digitalocean.com/account/api/tokens -- needs
# read + write scope, since launch_do.sh creates/destroys Droplets and
# registers an SSH key on your account.
DIGITALOCEAN_ACCESS_TOKEN=
