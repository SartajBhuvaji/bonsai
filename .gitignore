# secrets -- never commit
.env
.env.*
!.env.example
*.pem
*_rsa
*_ed25519
id_*

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
uv.lock
.tox/

# local experiment tracking (bonsai.tracking.new_run) -- these are run
# outputs, not source, and can get large once real training starts
runs/

# model weights and checkpoints -- never committed, always re-downloaded or
# re-produced
models/
*.safetensors
*.gguf
*.bin
*.pt
*.ckpt

# Jupyter's autosave directory; the committed notebook is the real copy
.ipynb_checkpoints/

# tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# editors and OS
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
